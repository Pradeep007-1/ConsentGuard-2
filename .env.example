# ConsentGuard Environment Configuration

# Flask Session Security Key
# In production, set this to a random 64-character secret
SECRET_KEY=consentguard-production-secret-key-change-in-production

# Persistent Database URL (Optional for local development, recommended on Vercel)
# Local development defaults to SQLite at backend/consentguard.db when DATABASE_URL is unset.
# For Vercel production persistence across lambda deployments, provide a PostgreSQL connection URL
# (e.g., from Neon, Supabase, Vercel Postgres, AWS RDS):
# DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
