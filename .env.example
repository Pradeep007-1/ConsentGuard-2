# ==============================================================================
# ConsentGuard Environment Configuration (.env.example)
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Flask Session & Cryptographic Secret Key
# In production, configure a random 64-character hexadecimal or base64 secret.
SECRET_KEY=replace-with-a-secure-random-64-character-secret-key

# Administrative Secret Key
# Required for constant-time administrative operations (/api/notice/update, /api/notice/reset)
ADMIN_KEY=replace-with-admin-infrastructure-secret-key

# Downstream Partner Consumer API Keys
# Seeded partner consumers authenticate via X-API-Key header or JSON api_key
PARTNER_ALL_KEY=replace-with-partner-all-enterprise-api-key
PARTNER_LIMITED_KEY=replace-with-partner-limited-research-api-key

# Database Connection URL (Optional for local offline SQLite, recommended for Vercel/Neon)
# When unset, defaults to local persistent SQLite at backend/consentguard.db
# For production Neon PostgreSQL / RDS:
# DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
